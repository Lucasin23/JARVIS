# JARVIS environment configuration. Copy to ".env" and fill in your values.

# ElevenLabs API key — enables the winning Jarvis voice (Paul-Bettany-like,
# voice_id xbpwjFFJpcRThvL5EyVi). Get one at https://elevenlabs.io → Developers.
# When unset, JARVIS automatically falls back to the original local Kokoro voice.
ELEVENLABS_API_KEY=

# OpenAI-compatible LLM (optional — enables AI conversation mode).
# OPENAI_API_KEY=
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
